# IBDers 根环境模板 — 复制为 .env 后按需修改
# .env 已在 .gitignore 中，勿提交真实密钥

# ---- Compose / 基础设施 ----
POSTGRES_USER=ibd
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=ibd

MINIO_ROOT_USER=change-me-minio
MINIO_ROOT_PASSWORD=change-me-minio-secret

# ---- 存储（Docker 内 S3）----
STORAGE_DRIVER=local
S3_BUCKET=ibd-uploads
S3_ACCESS_KEY_ID=change-me-minio
S3_SECRET_ACCESS_KEY=change-me-minio-secret
S3_REGION=us-east-1
STORAGE_SECRET=change-me-storage-secret

# 本地直传签名密钥与对外地址（生产必须改为真实域名，勿含 localhost）
PUBLIC_BASE_URL=http://localhost:3000

# ---- 可选 LLM ----
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- 可选 FCM 推送（services/api）----
# 未配置则 dry-run；payload 仅通用提醒文案，见 docs/push-privacy.md
# FCM_SERVER_KEY=
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
