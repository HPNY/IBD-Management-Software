# services/api — 复制为 .env 后使用
# 生产：NODE_ENV=production 时以下危险默认值会导致拒绝启动

NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://ibd:change-me-postgres@127.0.0.1:5433/ibd
REDIS_URL=redis://127.0.0.1:6380

# JWT
JWT_SECRET=change-me-jwt-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# 开发验证码：仅 development；production 使用默认值会启动失败
DEV_SMS_CODE=123456

# 迁移：生产建议 false，由独立 Job 执行
RUN_MIGRATIONS=true
# 禁止在生产使用；production + true 会拒绝启动
DB_SYNC=false
DB_LOGGING=false

# 对象存储
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=var/uploads
STORAGE_SECRET=change-me-storage-secret
# 生产必须为真实 https 域名，禁止 localhost
PUBLIC_BASE_URL=http://127.0.0.1:3000

# S3 / MinIO（STORAGE_DRIVER=s3 时）
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=ibd-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_REGION=us-east-1

# FCM 推送（可选）：未配置则 dry-run，只记日志不真发
# 方式 A：传统密钥
# FCM_SERVER_KEY=
# 方式 B：服务账号（FCM HTTP v1）
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
