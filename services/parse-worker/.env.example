# services/parse-worker — 复制为 .env 后使用
PORT=8081
REDIS_URL=redis://127.0.0.1:6380
PARSE_QUEUE=parse
PARSE_CONCURRENCY=2

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=var/uploads

# S3（STORAGE_DRIVER=s3）
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1

# 可选 LLM（Skill 未命中时）
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SEC=60
