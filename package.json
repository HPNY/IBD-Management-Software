{
  "name": "ibd-management",
  "private": true,
  "version": "0.1.0",
  "description": "IBDers IBD 病程管理 monorepo（MVP 骨架）",
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "body-parser": "^1.20.9",
      "multer": "^2.5.0",
      "proxy-addr": "^2.0.8",
      "source-map-js": "^1.2.2",
      "lodash": "^4.18.0",
      "lodash-es": "^4.18.0",
      "brace-expansion@2": "^2.1.6",
      "js-yaml@4": "^4.3.0",
      "form-data@2": "^2.5.4",
      "swiper": "^12.1.2",
      "follow-redirects": "^1.16.1",
      "glob@10": "^10.5.0",
      "joi@>=17.1.1 <17.13.9": "17.13.9"
    }
  },
  "scripts": {
    "build:api": "pnpm --filter @ibd/api build",
    "start:api": "pnpm --filter @ibd/api start:dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:prune": "eslint . --prune-suppressions",
    "format": "prettier --write .",
    "format:check": "node scripts/check-format-changed.mjs",
    "format:check:all": "prettier --check .",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "pr:guard": "node scripts/pr-guard.mjs",
    "quality": "pnpm lint && pnpm typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "prettier": "3.10.0",
    "typescript-eslint": "8.72.2"
  }
}
